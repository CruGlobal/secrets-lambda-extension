#!/bin/bash

filename=$(/opt/secrets-lambda-extension/bin/secrets)
if [ $? -ne 0 ]; then
    echo "Failed to retrieve secrets: $filename"
    exit 1
fi
# Check the file before sourcing it, so the function never starts without its secrets
# because the file wasn't there. source's own exit status is only that of the file's last
# line, so it can't tell a file it couldn't read from one whose last export failed.
if [ ! -f "$filename" ] || [ ! -r "$filename" ]; then
    echo "Failed to retrieve secrets: could not read $filename"
    exit 1
fi
source "$filename"

exec $@
